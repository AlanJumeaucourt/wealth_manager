# Required
SQLITE_DB_PATH=/path/to/wealth.sqlite
JWT_SECRET_KEY=your-secret-key

# Optional
PORT=5000
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# GoCardless (optional, for bank linking)
# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=

# Demo mode (optional)
# DEMO_MODE=true
# DEMO_SIMULATION_YEARS=10

# Logging: set to 1 for one JSON line per response (method, path, status, duration_ms, reason, user_id)
# LOG_JSON=0

# AI assistant (OpenRouter)
# OPENROUTER_API_KEY=
# AI_MODEL=deepseek/deepseek-v4-flash:free
# AI_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# Per-request and run-level retries on 429/502/503 (exponential backoff)
# AI_RETRY_MAX_ATTEMPTS=6
# AI_RETRY_BASE_DELAY_MS=1500
# AI_HTTP_MAX_RETRIES=3
# AI_RUN_TIMEOUT_SEC=600
# AI_MAX_STEPS=25
# AI_MAX_TOOL_RESULT_CHARS=12000
# AI_RUN_TTL_SEC=3600
