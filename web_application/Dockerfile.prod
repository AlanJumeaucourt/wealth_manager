# Build context: repository root (`wealth/`) so `backend/` is available for the workspace dependency.
FROM oven/bun:1 AS builder

# Root `prepare` runs `vp config`, which needs `git`.
RUN apt-get update && apt-get install -y --no-install-recommends git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /repo

COPY package.json bun.lockb ./
COPY backend/package.json ./backend/
COPY web_application/package.json ./web_application/
COPY showcase_website/package.json ./showcase_website/

RUN bun install

COPY backend ./backend
COPY web_application ./web_application
COPY showcase_website ./showcase_website

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

WORKDIR /repo/web_application
RUN bun run build

FROM nginx:alpine

COPY --from=builder /repo/web_application/dist /usr/share/nginx/html
COPY web_application/nginx.conf /etc/nginx/conf.d/default.conf

CMD ["nginx", "-g", "daemon off;"]
